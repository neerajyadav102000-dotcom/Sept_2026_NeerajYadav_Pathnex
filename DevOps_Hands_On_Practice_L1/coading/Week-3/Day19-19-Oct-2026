# Day 19 - Git Deploy , RDS Skeleton, Rolling Strategy, Ping Check
# Ansible - Deploy App using Git
---
- name: Deploy app from Git for Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install git
      yum:
        name: git
        state: present
    - name: Clone repository
      git: 
        repo: "https://github.com/pathnex/app.git"
        dest: "/opt/pathnex-app"

# terraform - RDS Skeleton (MySQL)
# variable.tf
variable "db_password"{
    description = "RDS master password"
    type        = string
    sensitive   = true
}
resource "aws_db_instance" "PathnexRDS" {
    identifier              = "pathnex-rds"
    allocated_storage       = 20
    storage_type            = "gp3"
    engine                  = "mysql"
    engine_version          = "8.0"
    instance_class          = "db.t3.micro"
    username                = "admin"
    password                = var.db_password
    skip_final_snapshot     = true
}

# Kubernetes - Deployment Rolling Update (Detailed)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pathnex-rollout

spec:
  replicas: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurger: 2
      maxUnavailable: 1
  selector:
    matchLabels: 
      app: rollout
  template:
    metadata:
      labels:
        app: rollout
    spec:
      conatiners:
        - name: app
          image: nginx

# Shecll Script - Check Internet Connectivity
#!/bin/bash bash
set -uo pipefail
TARGET="google.com"

if ping -c 4 "${TARGET}" > /dev/null 2>&1: then
  echo "Internet is available"
else
echo "No Internet Connection"
exit 1
fi

# Approvals

# Jenkins Pipeline - Manual Approval
You will learn how to **pause pipeline until manual approval**.
pipeline {
    agent none
    environment {
        INSTITUTE_NAME = "Pathnex"
    }
    stages {
        stage('Approve Deployment') {
            steps {
                input message: "Approval deployment for $INSTITUTE_NAME?"
            }
        }
        stage('Deploy') {
            agent any
            steps {
              sh 'echo "Deployment approved and execute for $INSTITU_NAME!"'
           }
        }
    }
}

# GitLab CI - Manual Approval Job
You will learn how to **use manual jobs in GitLab CI for approvals**.

stages:
  - deploy

variables:
  INSTITUTE_NAME: "pathnex"

deploy:
  stage: deploy
  image: alpine:latest
  script:
    - echo "Ready to deploy $INSTITUTE_NAME"
  when: manual
