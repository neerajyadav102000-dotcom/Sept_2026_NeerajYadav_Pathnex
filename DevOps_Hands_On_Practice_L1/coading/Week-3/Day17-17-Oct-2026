# Jenkins pipeline - Simulaed Deployment

pipeline {
    agent any
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Deployment Environment')
    }
    environment {
        INSTITUTE_NAME = "pathnex"
    }
    stages {
        stage('Deploy') {
            steps {
                sh 'echo "Deploying ${INSTITUTE_NAME} application to ${params.ENVIRONMENT}\"'
            }
        }
    }
}

