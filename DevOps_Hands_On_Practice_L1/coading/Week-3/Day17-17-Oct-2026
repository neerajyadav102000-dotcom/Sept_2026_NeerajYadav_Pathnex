# Day 17 - Loops, ALB, Namespace, Top Processes
# Ansible - Create Multiple users in Loop

---
- name: Create Multiple Pathnex users
  hosts: all
  become: yes

  vars:
    users:
      - dev1
      - dev2
      - dev3

  tasks:
    - name: Ensure Pathnex users exist
      ansible.builtin.user:
        name: "{{ item }}"
        state: present
      loop: "{{ users }}"

# Terraform - Applications Load Balancer
resource "aws_lb" "PathnexALB" {
    name                = "pathnex-alb"
    load_balancer_type  = "applications"
    subnets             = [
        aws-subnet.PathnexSubnet1.id
        aws_subnet.pathnexSubnet2.id
    ]

    tags = {
        Name = "Pathnex_ALB"
    }
}

# Kubernetes - Namespace + Deployment
apiVersion: v1
kind: Namespace
metadata:
   name: pathnex-namespace

---
apiVersion: apps/v1
kind: Deployment
metadata:
   name: pathnex-deploy
   namespace: pathnex-namespace

spec:
  replicas: 2
  selectors:
    matchLabels:
      app: pathnex
  template:
    matadata:
      labels:
        app: apthnex
    spec:
      containers:
        - name: app
          image: nginx:stable

# Shell Script - top 5 memory Processes

#!/bin/env bash
set -euo pipefail
ps aux --sort=-%mem | head -n 6

