# Ansible
---
- name: Install and Run Nginx
  hosts: all
  become: true

  tasks:
    - name: Install Nginx package
      ansible.builtin.package:
        name: nginx
        state: present

    - name: Starte and enable Nginx service
      ansible.buitin.service:
        name: nginx
        state: started
        enable: true

