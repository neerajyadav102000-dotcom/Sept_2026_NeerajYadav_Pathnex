# Day 03 - Users, SGs, Env Vars

# Ansible - Create Users

---
 - name: Create HCL User
   hosts: all
   become: yes

   tasks:
    - name: Create User hcl-admin
      user:
       name: hcl-admin
       shell: /bin/bash
       state: present

# Terraform - Security Group (r6i.4xlarge EC2)
provider "aws" {
    region  = "ap-south-1"
}

resource "aws_security_group" "HCLsg" {
    name            = "hclsg"
    description     = "hcl SG For SSH"

    ingress {
        from_port = 22
        to_port   = 22
        protocol  = "tcp"
        cidr_blocks =["0.0.0.0/0"]
    }
}

resource "aws_instance" "hclEC2" {
    ami                     = "ami0abcd1234abcd1234"
    instance_type           = "t3.micro"
    vpc_security_group_ids  = [aws_security_group.HCLsg.id]

    tags = {
      Name = "hcl_EC2"  
    }
}

# Kubernetes - Add Environment Variables
apiVersion: apps/v1
kind: Pod
metadata:
    name: hcl-env-pod
spec:
 containers:
    - name: app
      image: nginx
      env:
        - name: APP_ENV
          value: "production"

