#Jenkins Pipeline
You will learn to **combine all tasks into a realistic Jenkins Pipeline** with proper stages and tags.
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM           = "DevOps"
        ENV            = "prod"
        PROJECT        = "Pathnex-Training"
    }
    stages {
        stage('Infrastructure') {
            steps {
                script {
                    echo "Initializing infrastructure for ${env.PROJECT} in ${env.ENV} by team ${env.TEAM} (${env.INSTITUTE_NAME})..."
                    sh 'terraform init && terraform apply -auto-approve'
                }
            }
        }
        stage('App Deployment') {
            steps {
                script {
                    echo "Deploying applications using Ansible and Kubernetes..."
                    sh 'ansible-playbook -i inventory playbook.yml'
                    sh 'kubectl apply -f k8s-manifest.yaml'
                }
            }
        }
        stage('Monitoring Checks') {
            steps {
                script {
                    echo "Running system monitoring scripts..."
                    sh './system_checks.sh'
                }
            }
        }
    }
}


# GitLab CI
stages:
  - infrastructure
  - app_deployment
  - monitoring_checks

variables:
  INSTITUTE_NAME: "Pathnex"
  TEAM: "DevOps"
  ENV: "prod"
  PROJECT: "Pathnex-Training"

infrastructure_stage:
  stage: infrastructure
  image: hashicorp/terraform:latest
  script:
    echo "Running Terraform for $PROJECT in $ENV ($INSTITUTE_NAME)..."
    - terraform init
    - terraform apply -auto-approve

app_deployment_stage:
  stage: app_deployment
  image: alpine:latest
  script:
    - echo "Executing Ansible Playbooks and Kubernetes Manifests..."
    - apk add --no-cache ansible kubectl
    - ansible-playbook -i inventory playbook.yml
    - kubectl apply -f k8s-manifest.yaml

monitoring_stage:
  stage: monitoring_checks
  image: alpine:latest
  script:
    - echo "Executing monitoring checks for team $TEAM..."
    - chmod +x system_checks.sh
    - ./system_checks.sh
