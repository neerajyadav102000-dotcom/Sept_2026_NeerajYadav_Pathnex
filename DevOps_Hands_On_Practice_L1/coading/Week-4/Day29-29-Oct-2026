# Terraform
provider "aws" {
  region = "us-east-1"
}

# 1. Key Pair
resource "aws_key_pair" "pathnex_key" {
  key_name   = "pathnex-deployer-key"
  public_key = "ssh-rsa ABCDXYZ"
}

# 2. Security Group
resource "aws_security_group" "pathnex_sg" {
  name        = "pathnex-sg"
  description = "Allow SSH and HTTP"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# 3. EC2 Instance (c5.xlarge)
resource "aws_instance" "pathnex_server" {
  ami           = "ami-0abcd1234abcd1234" 
  instance_type = "c5.xlarge"
  key_name      = aws_key_pair.pathnex_key.key_name
  vpc_security_group_ids = [aws_security_group.pathnex_sg.id]

  tags = {
    Name = "Pathnex-Server"
  }
}

# 4. EBS Volume
resource "aws_ebs_volume" "pathnex_ebs" {
  availability_zone = aws_instance.pathnex_server.availability_zone
  size              = 20
  type              = "gp3"

  tags = {
    Name = "Pathnex-EBS"
  }
}

resource "aws_volume_attachment" "ebs_att" {
  device_name = "/dev/sdh"
  volume_id   = aws_ebs_volume.pathnex_ebs.id
  instance_id = aws_instance.pathnex_server.id
}

# 5. Output IP
output "instance_ip" {
  value       = aws_instance.pathnex_server.public_ip
  description = "Public IP of the Pathnex EC2 instance"
}


# Ansible
---
- name: Configure Pathnex Web Server
  hosts: all
  become: yes
  tasks:
    - name: Install Nginx
      yum:
        name: nginx
        state: present

    - name: Deploy Welcome to Pathnex HTML page
      copy:
        content: |
          <!DOCTYPE html>
          <html>
          <head>
              <title>Welcome to Pathnex</title>
          </head>
          <body>
              <h1>Welcome to Pathnex</h1>
              <p>Deployed successfully via Ansible!</p>
          </body>
          </html>
        dest: /usr/share/nginx/html/index.html
        mode: '0644'

    - name: Start and enable Nginx service
      service:
        name: nginx
        state: started
        enabled: yes

# Kubernetes
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pathnex-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pathnex-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pathnex-app
  template:
    metadata:
      labels:
        app: pathnex-app
    spec:
      containers:
      - name: nginx
        image: nginx:latest
        ports:
        - containerPort: 80
        volumeMounts:
        - mountPath: /usr/share/nginx/html
          name: pathnex-storage
      volumes:
      - name: pathnex-storage
        persistentVolumeClaim:
          claimName: pathnex-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: pathnex-service
spec:
  type: NodePort
  selector:
    app: pathnex-app
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30080


