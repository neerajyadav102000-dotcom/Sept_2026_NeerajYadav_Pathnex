#Matrix Builds
#Jenkins Pipeline - mareix Build
You will learn how to **run thes build on multiple environmnet**.
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "pathnex"
    }
    stages {
        stage('Matrix Build') {
            matrix {
                axes {
                    axis {
                        name 'JAVA_VERSION'
                        values '8', '11', '17'
                    }
                }
                stages {
                    stage('Build') {
                        steps {
                            sh "echo Building with Java ${JAVA_VERSION} for ${INSTITUTE_NAME}"
                        }
                    }
                }
            }
        }
    }
}


