# Ansible - install Packages Using Variables

---
- name: Install package using variables
  hosts: all
  become: yes

  vars:
    pathnex_packages:
      - tree
      - unzip
      - vim
  tasks:
    - name: Install required packages
      yum:
        name: "{{pathnex_packages}}"
        state: present

# Terraform - Create VPC - Subnete

provider "aws" {
    region  = "ap-south-1"
}

resource "aws_vpc" "pathnexVPC" {
    cidr_block  = "172.16.0.0/16"

    tags = {
        Name = "PathnexVPC"
    }
}

resource "aws_subnet" "PathnexSubnet"{
    vpc_id      = aws_vpc.pathnexVPC.id
    cidr_block = "172.16.1.0/24"
    map_public_ip_on_launch = true

    tags = {
        Name = "Pathnex-Subnet"
    }
}

# Kubernetes - add Liveness & Readyness Probes
apiVersion: v1
kind: Pod
metadata:
  name: pathnex-probes-pod

spec:
  containers:
    - name: web
      image: nginx
      livenessProbe:
        httpGet:
          path: /
          port: 80
        initialDelaySeconds: 5
      readynessProbe:
        httpGet:
          path: /
          port: 80
        initialDelaySeconds: 3

