# jenkinsfile - Multi-Environment Deployment
 pipeline {
     agent any
     environment {
         IMAGE_NAME = "apana-web-app"
         Deploy_ENV = 'production'
       }
      stages {
        stage('Build') {
          steps {
            echo 'Building Docker image...'
            docker.build("${env.IMAGE_NAME}')
          }
      }
       stage('Test') {
         step {
            echo 'Running tests...'
         }
      }
       stage('deploy to Kubernetes') {
          steps {
             script {
                if (env.DEPLOY_NEW== 'production') {
                   sh 'kubectl apply -f kubernetes/prod-deployment.yaml'
                 } else {
                   sh 'kubectl apply -f kubernetes/dev-deployment.yaml'
                }
             }
          }
       }
     }
  }

# GitLab CI/CD - Environment-Sepcific Deployments
  stages:
    - build
    - push
    - deploy

 build: 
   stage: build
   script:
      - docker build -t apana-we-app .

 push: 
    stage: push
    script: 
       - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD"
       - docker push apana-web-app

 deploy:
    stage: deploy
    script:
       - |
         if [ "$CI_COMMIT_REF_NAME" == "main"]; then
           kubectl apply -f kubernetes/prod-deployment.yaml
         else
           kubectl apply -f kubernetes/dev-deployment.yaml
          fi

