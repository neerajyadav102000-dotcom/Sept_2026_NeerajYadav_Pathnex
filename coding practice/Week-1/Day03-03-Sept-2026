Ansible — Install Apache and Start Service
- name: Install and Start Apache
 host: all
 become: yes
 tasks:
  - name: install apache
    yum:
   name: httpd
  state: present

  - name: Start apache
        service:
         name: httpd
         state: started
        enable: yes
