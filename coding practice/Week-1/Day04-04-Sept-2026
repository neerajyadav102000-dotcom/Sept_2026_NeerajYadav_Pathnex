Day 04 - basic CI/CD Concept with Jenkins & Gitlab

  #Jenkinsfile - Basic CI Pipeline
  pipeline{
        agent any
         stages {
          stage('Build') {
            steps {
               echo 'Buliding project'
             }
           }
           stage('Test') {
             steps {
                echo 'running tests'
               }
            }
            satge('Deploy') {
               step {
                echo 'Deploying application'
              }
          }
       }
    }

       # Gitlab CI/CD - Basic pipeline
       stages:
        - build
        - test
        - deploy

     build:
       satge:build
       script:
        - echo "Building project"

        test:
          satge: test
           script:
           - echo "Running tests"
 
      deploy:
        satge: deploy
        script:
          - echo "Deploying application"



 # Anshible - install and Configure nginx
   - name :Install and configure Nginx
     hosts: all
     become: yes
     tasks:
       - name: install nginx
          yum:
           name: nginx
           state: present
      - name: Configure nginx
         template:
           scr: nginx.conf.j2
           dest: /etc/nginx/nginx.conf
        - name : Start nginx server
           service:
            name: nginx
            state: started
            enabled: yes


