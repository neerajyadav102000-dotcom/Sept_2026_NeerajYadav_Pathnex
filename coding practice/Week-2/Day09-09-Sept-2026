Day 09 - Docker Integration with jenkins & Gitlab

# Ansible - Setup Docker Container for Nginx
 - name: Setup Docker Container For Nginx
 host: all
 become: yes
 tasks:
  - name: Pull Nginx image
    docker_image:
      name: nginx
      source: pull
   - name: Run Nginx container
       docker_container:
         name: nginx_container
         image: nginx
         state: started
         published_ports:
            - "8080":80"
 
# Terraform - EC2 with Auto Scaling Group
  resource "aws_lunch-configuration" "example" {
     name  = "neeraj-config"
     imaged_id = "ami-0abcd1234abcd1234"
     instance_type = "t3.micro"
  }
 
resource "aws_autoscaling_group" "example" {
  desired_capacity  = 2
  min_size          = 3
  max_size          = 5
  vpc_zone_identifier = ["subnet-12345678"]
  launch_configuration = aws_lunch_configuration.example.id
 }

# Kubernetes - Horizontal Pod Autoscaler (HPA)
apiVersion: apps/v1
kind: Deployment
 metadata:
    name: Neeraj-deployment
   spec:
    replicas: 1
    selector:
      metchLabels:
          app: Neeraj-app
	template:
	 metatdata:
	  labels:
		app: Neeraj-app
 	spec:
	  containers:
	   - name: nginx
		image: nginx
		ports:
		- containerPort: 80

---
 
 apiVersion: autoscaling/v2
 kind: HorizontalPodAutoscaler
 metadata:
	name: Neeraj-hpa
   spec:
	scaleTargetRef:
	 apiVersion: app/v1
	 kind: Deployment
	 name: Neeraj-deployment
	minReplicas: 1
	maxReplicas: 10
	targetCPUUtilizationPercentage: 60

# Jenkinsfile - Deploy to Kubernetes
 pipeline {
 	agent any
