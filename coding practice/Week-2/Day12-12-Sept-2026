# Day 12 - Scaling Applications and Automation
# Ansible -Setup Auot-Scaling Group (ASG)

- name: Setup Auto Scaling Group
  hosts: all
  become: yes

  tasks:
   - name: Create Auto Scaling Group
     amazon.aws.ec2_asg:
	name: neeraj-asg
	region: ap-south-1
	launch_config_name: neeraj-lunch-config
	min_size: 2
	max_size: 5
	desired_capacity: 3
	vpc_zone_identifier:
               - subnet-12345678

# Terraform - Create a Load Balancer with EC2 Instances

resource "aws_lb" "neeraj_lb" {
   name		= "neeraj-lb"
   internal	= false
   load_balancer_type = "application"
   security_groups    = [aws_security_group.all_ssh_http.id]
   subnets	      = [aws_subnet.public.id]
 }

resource "aws_instance" "neeraj_ec2" {
   ami 		=  "ami-0abcd1234abcd1234"
   instance_type = "t3.micro"
   security_groups = [aws_security_group.allow_ssh_http.name]
   tags = {
     Name = "Neeraj-EC2"
   }
 }

# Kubernetes - Horizontal Pod Autoscaler (HPA) with Load Balancer
 apiVersion: apps/v1
 kind: Deployment
 metadata:
   name: neeraj-web-app
  spec:
     replicas: 3
     selector:
      matchLabels:
	app: neeraj-web-app
    template:
      metadata:
        labels:
	  app: neeraj-web-app
	spec:
	  containers:
	     - name: web
	       image: nginx
	       ports:
		- containerPort: 80

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
   name: neeraj-web-app-hpa
 spec:
    scaleTargetRef:
	apiVersion: apps/v1
	kind: Deployment
	name: neeraj-web-app
     minReplicas: 2
     maxReplicas: 5
     metrics:
	- type: Resource
 	  resource:
	     name: cpu
	     target:
	     type: Utilization
     	     averageUtilization: 75


