# Day 22 - Multi-cluster kubernetes Management
# Ansible - Deploy Nginx Across Multiple Kubernetes Clusters
 - name: Deploy Nginx across multiple kubernetes clusters
   host: localhost
   tasks:
     - name: Configure kubectl for cluster 1
       command: kubectl --context=ap-south config use-context ap-south-cluster
     - name: Deploy Nginx on Cluster 1
       command: kubectl apply -f kubernetes.deployment.yaml
     - name: Configure kubectl for cluster 2
       command: kubectl --context=ap-south config use-context ap-south-cluster
     - name: Deploy nginx on Cluster 2
       command: kubectl apply -f kubernetes/deployment.yaml

# Terraform - Multi-Region Kubernetes Cluster with EKS and GKE
resource"aws_eks_cluster" "madan_eks" {
  name 		= "madan-eks-cluster"
  role_arn 	= aws_iam_role.eks_cluster_role.arn

  vpc_config {
     subnet_ids = [aws_subnet.madan_subnet.id]
   }

  depends_on = [aws_iam_role_policy_attachment.eks_cluster_role_policy]
}

resource "google_container_cluster" "madan_gke" {
  name 		= "madan-gke_cluster"
  location = "us-centrall-a"
  initial_node_count = 5
  node_config {
   machine_type = "n1-standard-1"
 }
}

# Kubernetes - Federated Deployment with Multiple Clusters
apiVersion: apps/v1
kind: Deployment
metadata:
    name: madan-deployment
spec:
   replicas: 5
   selector:
      matchLabels:
         app: madan-app
   template:
     metadata:
       labels:
          app: madan-app
       spec:
   	 containers:
	    - name: nginx
	      image: nginx
	      ports:
	        - containerPort: 80

---
apiVersion: federation.k8s.io/v1beta1
kind: federatedDeployment
metadata:
    name: madan-federated-deployment
    namespace: default
spec:
   template:
     spec:
       replicas: 5
       selector:
         matchLabels:
 	   app: madan-app
	spec:
	   conatiners:
	    - name: nginx
	      image: nginx
	      ports:
	        - conatinerport: 80

# Jenkinsfile - Multi-Cluster Deployment Strategy
pipeline {
   agent any
   stages {
      stage('Deploy to Cluster 1')
        steps {
	  script {
		sh 'kubectl --context=ap-south-cluster apply -f kubernetes/deployment.yaml'
	   }
	}
     }
    stage('Deploy to Cluster 2') {
 	steps {
	   script {
		sh 'kubectl --context=ap-south-cluster apply -f kubernetes/deployment.yaml'
	      }
	   }
	}
     }
  }

